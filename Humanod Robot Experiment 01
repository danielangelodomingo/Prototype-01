# OVERHAUL STAGE 4: SIM-TO-REAL DOMAIN RANDOMIZATION ENGINE
# =====================================================================
class SimToRealDomainRandomizer:
    """Injects motor latency jitter, variable friction, and payload noise."""
    def __init__(self):
        self.friction_mu = 0.8
        self.motor_latency_jitter_ms = 0.0

    def apply_domain_randomization(self, ideal_torques):
        # 1. Randomize Floor Friction Parameter mu ∈ [0.2, 1.0]
        self.friction_mu = round(random.uniform(0.25, 0.95), 3)
        
        # 2. Inject Motor Latency Jitter (2 - 10 ms delay simulation)
        self.motor_latency_jitter_ms = round(random.uniform(2.0, 10.0), 2)
        
        # 3. Add Motor Torque Noise & Friction Scaling
        torque_noise = np.random.normal(0, 0.35, size=len(ideal_torques))
        randomized_torques = (ideal_torques * self.friction_mu) + torque_noise
        
        return np.clip(randomized_torques, -80.0, 80.0)

# ---------------------------------------------------------------------
# EXCEPTION-FREE DYNAMIC KALMAN FILTER & CAN-BUS INTERFACE
# ---------------------------------------------------------------------
class DynamicExtendedKalmanFilter:
    def __init__(self, dim=6):
        self.dim = dim
        self.x = np.zeros(dim)
        self.P = np.eye(dim) * 0.1
        self.Q = np.eye(dim) * 0.001
        self.R = np.eye(dim) * 0.02
        self.H = np.eye(dim)

    def update(self, z_raw):
        x_pred = self.x
        P_pred = self.P + self.Q
        S = np.dot(np.dot(self.H, P_pred), self.H.T) + self.R
        K = np.dot(np.dot(P_pred, self.H.T), np.linalg.inv(S))
        y = z_raw - np.dot(self.H, x_pred)
        self.x = x_pred + np.dot(K, y)
        self.P = np.dot((np.eye(self.dim) - np.dot(K, self.H)), P_pred)
        return self.x

class RobustCANBusInterface:
    def transmit_frames(self, torques):
        frames = {}
        for i, t in enumerate(torques):
            raw_int = int(np.clip(t * 100.0, -32768, 32767))
            packed_hex = struct.pack('>h', raw_int).hex().upper()
            frames[f"CAN_0x60{i+1}"] = f"0x{packed_hex}"
        return frames

