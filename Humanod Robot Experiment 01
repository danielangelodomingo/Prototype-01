    print("  OVERHAULED HUMANOID AI ENGINE (ROS2 + Convex MPC + VLA + Sim-to-Real)  ")
    print("=========================================================================")

    # Initialize Overhauled Architecture Modules
    ros2_bridge = ROS2NodePublisherSubscriberBridge()
    mpc_solver = ConvexModelPredictiveController()
    wbc_controller = WholeBodyController(num_joints=6)
    vla_engine = OpenVLAEmbodiedPipeline()
    domain_randomizer = SimToRealDomainRandomizer()
    
    ekf = DynamicExtendedKalmanFilter(dim=6)
    can_bus = RobustCANBusInterface()

    speak("ROS 2 Middleware, Convex MPC, Transformer VLA, and Sim-to-Real Engine Online.")

    # CLI Execution Path (Pydroid 3 / Terminal Execution)
    if not MUJOCO_AVAILABLE:
        print("\n[NOTE] 'mujoco' library not detected. Running Overhauled Real-Time CLI Loop...\n")
        
        raw_sensor_input = np.array([0.01, -0.02, 1.2, 0.0, 0.05, 0.0])
        
        for cycle in range(1, 4):
            sim_time = cycle * 0.002 * 250  # 500Hz Temporal Scaling
            
            # 1. Stage 1: ROS 2 Asynchronous Perception Pub
            vla_action = vla_engine.decode_prompt_and_depth("Walk forward safely")
            ros2_bridge.publish_topic("/perception/camera_lidar", vla_action)
            
            # 2. State Estimation via Dynamic EKF
            filtered_state = ekf.update(raw_sensor_input)
            
            # 3. Stage 2: Convex MPC Ground Reaction Force (GRF) Solution
            external_push = 15.0 if cycle == 2 else 0.0  # Simulate external push disturbance
            grf_forces = mpc_solver.solve_grf_qp(
                com_pos=filtered_state[:3], 
                com_vel=np.zeros(3), 
                external_disturbance_force=external_push
            )
            
            # Target Trajectory Generation
            phase = 2 * math.pi * 1.5 * sim_time
            target_q = np.array([
                math.sin(phase)*0.05, math.sin(phase)*0.35, max(0.0, -math.sin(phase)*0.55),
                math.sin(phase+math.pi)*0.05, math.sin(phase+math.pi)*0.35, max(0.0, -math.sin(phase+math.pi)*0.55)
            ])
            
            # Whole-Body Control (WBC) Torque Computation
            ideal_torques = wbc_controller.compute_wbc_torques(grf_forces, target_q, np.zeros(6), np.zeros(6))
            
            # 4. Stage 4: Sim-to-Real Domain Randomization
            robust_torques = domain_randomizer.apply_domain_randomization(ideal_torques)
            
            # 5. Hardware Encoding
            can_frames = can_bus.transmit_frames(robust_torques)
            ros2_bridge.publish_topic("/control/ethercat_can_socket", can_frames)
            
            print(f"--- [ 500Hz Loop Step {cycle} | Time: {sim_time:.3f}s ] ---")
            print(f"• ROS 2 DDS Topic Pub : /perception/camera_lidar | Proximity: {vla_action['obstacle_proximity_m']}m")
            print(f"• Dynamic EKF State   : Pos Z={filtered_state[2]:.4f}m, Pitch={filtered_state[4]:.4f}rad")
            print(f"• Convex MPC GRF Sol  : Foot Forces R={grf_forces[0]:.1f}N | L={grf_forces[1]:.1f}N")
            print(f"• Domain Randomization: Friction μ={domain_randomizer.friction_mu} | Jitter={domain_randomizer.motor_latency_jitter_ms}ms")
            print(f"• WBC Robust Torques  : {[round(float(t), 2) for t in robust_torques]} Nm")
            print(f"• Signed CAN Bus Frame: {list(can_frames.items())[0]}")
            time.sleep(0.5)
            
        speak("Overhauled System Loop Complete.")
        return

    # Desktop 3D MuJoCo Physics Viewer
    print("\n[LAUNCHING MUJOCO 500Hz REAL-TIME LOOP...]")
    model = mujoco.MjModel.from_xml_string(HUMANOID_XML)
    data = mujoco.MjData(model)

    with mujoco.viewer.launch_passive(model, data) as viewer:
        step_count = 0
        while viewer.is_running():
            step_start = time.monotonic()
            sim_time = data.time
            
            # EKF State
            raw_input = np.array([data.qpos[0], data.qpos[1], data.qpos[2], 0.0, 0.0, 0.0])
            filtered_state = ekf.update(raw_input)
            
            # Convex MPC + WBC
            grf_forces = mpc_solver.solve_grf_qp(filtered_state[:3], data.qvel[:3])
            phase = 2 * math.pi * 1.5 * sim_time
            target_q = np.array([
                math.sin(phase)*0.05, math.sin(phase)*0.35, max(0.0, -math.sin(phase)*0.55),
                math.sin(phase+math.pi)*0.05, math.sin(phase+math.pi)*0.35, max(0.0, -math.sin(phase+math.pi)*0.55)
            ])
            
            current_q = data.qpos[7:13] if len(data.qpos) >= 13 else np.zeros(6)
            current_v = data.qvel[6:12] if len(data.qvel) >= 12 else np.zeros(6)
            
            ideal_torques = wbc_controller.compute_wbc_torques(grf_forces, target_q, current_q, current_v)
            robust_torques = domain_randomizer.apply_domain_randomization(ideal_torques)
            
            data.ctrl[:6] = robust_torques
            mujoco.mj_step(model, data)
            viewer.sync()

            step_count += 1
            if step_count % 500 == 0:
                print(f"[500Hz Loop] Time: {sim_time:.2f}s | Friction μ: {domain_randomizer.friction_mu} | Max Torque: {np.max(np.abs(robust_torques)):.2f} Nm")

            elapsed = time.monotonic() - step_start
            time_until_next_step = model.opt.timestep - elapsed
            if time_until_next_step > 0:
                time.sleep(time_until_next_step)

if __name__ == "__main__":
    run_production_humanoid_system()
